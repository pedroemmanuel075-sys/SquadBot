# ===================================
# 🎮 SQUADRIFE BOT - CONFIGURAÇÃO
# ===================================

# Discord Bot Configuration
DISCORD_TOKEN=seu_token_discord_aqui
CLIENT_ID=seu_client_id_aqui
GUILD_ID=seu_guild_id_aqui

# Database
DATABASE_URL=./database/squadrife.db

# Server
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Roblox API (opcional para comandos Roblox)
ROBLOX_API_KEY=sua_chave_aqui

# WebHook para Logs (opcional)
LOG_WEBHOOK_URL=seu_webhook_url_aqui

# Support Server
SUPPORT_SERVER_INVITE=https://discord.gg/squadrife

# Prefixo do Bot
PREFIX=!
